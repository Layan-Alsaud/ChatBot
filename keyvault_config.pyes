import os
from azure.identity import DefaultAzureCredential
from azure.keyvault.secrets import SecretClient

# Maps each Key Vault secret name to the environment variable name backend.py expects
SECRET_TO_ENV_MAP = {
    "PROJ-DB-NAME": "DB_NAME",
    "PROJ-DB-USER": "DB_USER",
    "PROJ-DB-PASSWORD": "DB_PASSWORD",
    "PROJ-DB-HOST": "DB_HOST",
    "PROJ-DB-PORT": "DB_PORT",
    "PROJ-OPENAI-API-KEY": "OPENAI_API_KEY",
    "PROJ-AZURE-STORAGE-SAS-URL": "AZURE_STORAGE_SAS_URL",
    "PROJ-AZURE-STORAGE-CONTAINER": "AZURE_STORAGE_CONTAINER",
    "PROJ-CHROMADB-HOST": "CHROMA_HOST",   # backend.py reads CHROMA_HOST, not CHROMADB_HOST
    "PROJ-CHROMADB-PORT": "CHROMA_PORT",   # backend.py reads CHROMA_PORT, not CHROMADB_PORT
}

def load_secrets_from_key_vault():
    vault_name = os.environ.get("KEY_VAULT_NAME")
    if not vault_name:
        print("KEY_VAULT_NAME not set — skipping Key Vault, using existing .env values.")
        return

    vault_url = f"https://{vault_name}.vault.azure.net/"

    try:
        credential = DefaultAzureCredential()
        client = SecretClient(vault_url=vault_url, credential=credential)

        for secret_name, env_var in SECRET_TO_ENV_MAP.items():
            try:
                secret = client.get_secret(secret_name)
                os.environ[env_var] = secret.value
            except Exception as e:
                print(f"Warning: could not fetch '{secret_name}' from Key Vault: {e}")

        print(f"Loaded secrets from Key Vault '{vault_name}'.")
    except Exception as e:
        print(f"Warning: could not connect to Key Vault '{vault_name}': {e}. Falling back to .env values.")


